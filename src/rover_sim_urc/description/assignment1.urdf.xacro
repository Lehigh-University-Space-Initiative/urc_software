<?xml version="1.0"?>
<!-- A suspended front-left assembly for checking joint commands, not rover locomotion -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="assignment1_drivetrain">
  <link name="world"/>
  <joint name="test_stand_mount" type="fixed">
    <parent link="world"/><child link="chassis"/>
    <origin xyz="0 0 0.65"/>
  </joint>
  <link name="chassis">
    <inertial>
      <mass value="30"/>
      <inertia ixx="2.5" iyy="4.0" izz="5.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual><geometry><box size="1.0 0.65 0.18"/></geometry>
      <material name="blue"><color rgba="0.25 0.35 0.75 1"/></material>
    </visual>
    <collision><geometry><box size="1.0 0.65 0.18"/></geometry></collision>
  </link>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="chassis"/><child link="front_left_knuckle"/>
    <origin xyz="0.36 0.4 -0.20"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="20" velocity="2"/>
  </joint>
  <link name="front_left_knuckle">
    <inertial><mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual><geometry><box size="0.04 0.04 0.08"/></geometry></visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle"/><child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" velocity="6"/>
  </joint>
  <link name="front_left_wheel">
    <inertial><mass value="1.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <!-- Reusing the existing four-wheel SDF's radius, width, joint axis, and placement -->
    <visual><origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.1016" length="0.10"/></geometry>
      <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <visual><origin xyz="0.09 0 0"/><geometry><box size="0.02 0.105 0.02"/></geometry>
      <material name="orange"><color rgba="1 0.4 0 1"/></material>
    </visual>
    <collision><origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.1016" length="0.10"/></geometry>
    </collision>
  </link>
  <ros2_control name="Assignment1GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-6</param><param name="max">6</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_left_steering_joint">
      <command_interface name="position"><param name="min">-0.6</param><param name="max">0.6</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <ros><namespace>/assignment1</namespace></ros>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find rover_sim_urc)/config/assignment1_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
